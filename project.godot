; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Void"
config/features=PackedStringArray("4.7", "Forward Plus")
run/main_scene="res://scenes/world_viewer.tscn"
config/icon="res://icon.svg"

[autoload]

; Loads every content registry before the main scene exists (VOID-025). Must
; stay first in this list: nothing else in the game is meaningful without it.
ContentBoot="*res://src/Content/ContentBoot.cs"

[display]

window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[physics]

3d/physics_engine="Jolt Physics"

[input]

; Viewer controls (VOID-057). Written by Godot rather than by hand -- the
; serialised InputEvent literals below are version-specific and a hand-edited
; one parses as a silently dead binding.
;
; Every action carries a joypad binding as well as a key, per the Steam Deck
; rule in CLAUDE.md: no action here is reachable from the keyboard alone.

