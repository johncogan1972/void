; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Void"
config/features=PackedStringArray("4.7", "Forward Plus")
run/main_scene="res://scenes/main_menu.tscn"
config/icon="res://icon.svg"

[autoload]

; Loads every content registry before the main scene exists (VOID-025). Must
; stay first in this list: nothing else in the game is meaningful without it.
ContentBoot="*res://src/Content/ContentBoot.cs"

[display]

window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

; Pixel art: nearest-neighbour, never linear. Terrain tiles are 16x16 flat
; colours and the default bilinear filter blurs their edges into each other,
; which destroys the very thing the world viewer exists to judge -- where one
; biome stops and the next starts. Set project-wide rather than per-texture so
; new art cannot be added without it.
textures/canvas_textures/default_texture_filter=0
rendering_device/driver.windows="d3d12"

[dotnet]

project/assembly_name="Void"
