<Project Sdk="Godot.NET.Sdk/4.7.1">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <RootNamespace>Void</RootNamespace>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <!-- Godot.NET.Sdk globs **/*.cs; the test project and the author-facing
       command-line tooling are built separately. Void.Tools must be removed as
       well as excluded from the solution build: leaving it in would pull its
       Program.Main into the game assembly. -->
  <ItemGroup>
    <Compile Remove="Void.Tests/**" />
    <Compile Remove="Void.Tools/**" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Void.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ZstdSharp.Port" Version="0.8.8" />
  </ItemGroup>
</Project>
