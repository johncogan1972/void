<Project Sdk="Microsoft.NET.Sdk">

  <!-- Author-facing build tooling (VOID-026). Never shipped and never loaded by
       the engine: Void.csproj removes this folder from its glob, or the Godot
       SDK would pull Program.cs and its Main into the game assembly. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <RootNamespace>Void.Tools</RootNamespace>
    <AssemblyName>Void.Tools</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Void.csproj" />
  </ItemGroup>

</Project>
