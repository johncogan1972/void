  {
    // biome-content-spec §3.3. Distinguished from Meadow at Sub-Phase A by
    // palette alone: the thick trees, hanging vines and deep narrow rivers that
    // actually separate the two are W8, W8 and W6 respectively. That is
    // expected, not a defect -- see VOID-048's scope caveat.
    "id": "void:forest",
    "display_name": "Forest",
    "layer_category": "surface",
    "palette": {
      "surface_block": "void:grass",
      "subsurface_block": "void:dirt",
      // Mossy stone rather than plain stone is what reads as "forest" before
      // any vegetation exists to plant on it.
      "base_block": "void:mossy_stone",
      "wall_default": "void:root_wall",
      "wall_ambient": []
    },
    // Empty for the same reason Meadow's is: vegetation prefabs arrive with
    // VOID-026. Intended roster, so it is not lost: thick medium/tall trees,
    // hanging vines, ferns.
    "vegetation": {
      "trees": [],
      "plants": [],
      "decorations": []
    },
    "ore_biases": {
      "void:copper": 1.1,
      "void:iron": 1.1
    },
    // Reuses the shipped enemy roster. data/enemies/enemies.json holds five
