[
  // Biome ids are stable forever: saved worlds and campaign manifests reference
  // biomes by string id, so retire ids, never repurpose them. Every block, wall
  // and biome id named below must resolve — BiomeRegistryLoader fails the load
  // otherwise. Prefab and enemy ids are allowed to dangle until VOID-024 and
  // VOID-023 land their registries.
  {
    "id": "void:meadow",
    "display_name": "Meadow",
    "layer_category": "surface",
    "palette": {
      "surface_block": "void:grass",
      "subsurface_block": "void:dirt",
      "base_block": "void:stone",
      "wall_default": "void:dirt_wall",
      // biome-content-spec §8 suggests mossy and rooted dirt wall variants;
      // neither exists in data/walls/walls.json yet, so this stays empty rather
      // than inventing wall entries.
      "wall_ambient": []
    },
    // Emptied in VOID-025, when boot began validating vegetation refs: these
    // prefabs were authored ahead of the prefabs themselves and every id
    // dangled. VOID-026 (the Tiled prefab converter) restores them together
    // with the real prefabs. What was here, so the intent is not lost:
    //   trees:       void:oak_small 0.5, void:oak_medium 0.3, void:oak_large 0.2
    //   plants:      void:wildflower_yellow 0.4
    //   decorations: void:grass_tall 1.0
    "vegetation": {
      "trees": [],
      "plants": [],
      "decorations": []
    },
    // Ores not listed here generate at their base rate (multiplier 1.0).
    "ore_biases": {
      "void:copper": 1.2,
      "void:iron": 0.9
    },
    "enemies": [
      { "enemy_id": "void:rabbit", "weight": 0.6, "time_of_day": "day" },
      { "enemy_id": "void:deer", "weight": 0.3, "time_of_day": "day" },
      { "enemy_id": "void:grey_wolf", "weight": 0.4, "time_of_day": "night" },
      { "enemy_id": "void:small_skeleton", "weight": 0.3, "time_of_day": "night" }
    ],
    "underground_variant": "void:root_hollows",
    // Ambient is post-MVP in full; nothing reads these yet.
    "ambient": {
      "music_theme": null,
      "particle_effect": null,
      "light_tint": null
    },
    // Hazards are portal-world only.
    "hazards": []
  },
  {
