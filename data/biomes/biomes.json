  {
    // biome-content-spec §3.6. The steep mountains and high cave density that
    // define Frostreach are W4 and W5; here it is snow and ice.
    "id": "void:frostreach",
    "display_name": "Frostreach",
    "layer_category": "surface",
    "palette": {
      "surface_block": "void:snow",
      "subsurface_block": "void:ice",
      "base_block": "void:stone",
      "wall_default": "void:ice_wall",
      "wall_ambient": []
    },
    // Rows of ice under the snow, overriding the world type's default of 4
    // (VOID-056). A snowpack over glacial ice is genuinely a deeper band than
    // topsoil over stone, and the extra rows are what stop a shallow cave from
    // opening straight through the ice into bare stone. Every other shipped
    // biome omits this key and takes the default, which is the intended common
    // case -- state it only where the palette actually reads differently.
    "subsurface_depth": 6,
    // Intended roster: boreal conifers, frost-hardy shrubs. Awaits VOID-026.
    "vegetation": {
      "trees": [],
      "plants": [],
      "decorations": []
    },
    // The spec calls for silver and a rare frost ore. Neither ore exists, and
    // ore_biases are NOT validated against any registry, so naming them would
    // dangle silently forever. Biasing only shipped ores keeps the file honest.
    "ore_biases": {
      "void:iron": 1.2,
      "void:copper": 0.7
    },
    // As with Forest: shipped enemies only. Rabbits and wolves on a snow
    // mountain are placeholder, not design -- a frost roster is its own ticket.
    "enemies": [
      { "enemy_id": "void:rabbit", "weight": 0.3, "time_of_day": "day" },
      { "enemy_id": "void:grey_wolf", "weight": 0.6, "time_of_day": "night" },
      { "enemy_id": "void:small_skeleton", "weight": 0.4, "time_of_day": "night" }
    ],
    // Deliberately outside the root_* family: there are no tree roots under a
    // snow mountain, and the name describes the place rather than matching a
    // pattern. See VOID-048's correction comment.
    "underground_variant": "void:frozen_halls",
    "ambient": {
      "music_theme": null,
      "particle_effect": null,
      "light_tint": null
    },
    "hazards": []
  },
  {
