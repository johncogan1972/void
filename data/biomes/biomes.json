    "id": "void:root_hollows",
    "display_name": "Root Hollows",
    "layer_category": "underground",
    "palette": {
      "surface_block": "void:dirt",
      "subsurface_block": "void:dirt",
      "base_block": "void:stone",
      "wall_default": "void:dirt_wall",
      "wall_ambient": ["void:stone_wall"]
    },
    "vegetation": {
      "trees": [],
      "plants": [],
      "decorations": []
    },
    "ore_biases": {
      "void:copper": 1.4
    },
    "enemies": [
      { "enemy_id": "void:cave_beetle", "weight": 0.5, "time_of_day": "any" }
