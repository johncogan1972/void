[
  // World types are the per-template generation config of world-generation-spec
  // §4 and §6. Ids are stable forever: every saved world records its world type
  // by string id, so retire ids, never repurpose them.
  //
  // Layer proportions must sum to 1 and must leave every layer at least one row
  // tall at every size preset listed here — WorldTypeRegistryLoader refuses the
  // load otherwise, because a squashed layer generates a wrong world rather than
  // a failing one.
  //
  // Size presets live here rather than in code so that shipping Small or Large
  // is a content change. MVP generates Medium only; the other two are declared
  // and unused, which is exactly the point.
  {
    "id": "void:home",
    "display_name": "Home World",
    // The default 30/25/30/15 of spec §4. On Medium this yields boundaries
    // 540 / 990 / 1530, with the void running 1530-1800.
    "layer_proportions": {
      "outside": 0.30,
      "underground": 0.25,
      "deep": 0.30,
      "void": 0.15
    },
    // Phase 1 step 2 surface elevation (VOID-047). The octave stack is fBm over
    // the column index: frequency is in lattice cells per tile, so 1/512 is a
    // hill range about eight chunks wide, and each further octave halves the
    // amplitude while doubling the frequency.
    //
    // The band fractions are fractions of the *outside layer*, not of world
    // height, so they scale across size presets untouched: 0.45-0.80 of Medium's
    // 540-row outside layer puts the surface in rows 243-432 and leaves 243 rows
    // of sky above it. Changing any of these regenerates the terrain of every
    // existing seed, with no code change — which is the point.
    "heightmap": {
      "octaves": 4,
      "frequency": 0.001953125,
      "lacunarity": 2.0,
      "persistence": 0.5,
      "surface_top_fraction": 0.45,
      "surface_bottom_fraction": 0.80,
      // Rows of elevation change allowed between adjacent columns. 3 is a
      // steep-but-walkable slope; raising it lets cliffs form.
      "max_column_delta": 3,
      // Surface roughness, added on top of the octave stack above in rows
      // (VOID-061). Without it the surface changes by at most one row per
      // column and is flat in 81% of them, so rounding a gentle ramp to whole
      // rows lands the steps at even intervals and the ground reads as a
      // staircase. This is a separate field rather than more octaves because
      // fBm normalises: roughening the stack above pays for texture with hill
      // amplitude, and measured, persistence 0.70 cut the world's elevation
      // range from 83 rows to 71.
      //
      // This is the default. A biome overrides it with its own surface_detail;
      // see data/biomes/biomes.json.
      "detail": {
        "octaves": 2,
        // In lattice cells per tile column, like frequency above. 1/16 puts a
        // feature every sixteen columns -- short enough to break up a slope,
        // long enough not to read as noise.
        "frequency": 0.0625,
        "lacunarity": 2.0,
        "persistence": 0.5,
        // Peak displacement in rows, not a fraction of the band: the staircase
        // is a row-quantisation artefact, so the useful unit is rows, and a
        // fraction would silently change this between size presets.
        "amplitude_rows": 4.0
      }
    },
    // Phase 1 step 4 surface biomes (VOID-048). Two independent low-frequency
    // fields give each column a temperature and a humidity in [0, 1], and the
    // FIRST rule below whose rectangle contains that point names the column's
    // surface biome — so the array order is part of the world's identity, not
    // presentation. The rules must together cover the whole unit square;
    // WorldTypeRegistryLoader proves that at boot, so no column can end up
    // unclassifiable. Overlap between rules is legal and is resolved by order.
    //
    // The two frequencies are deliberately different. Matched frequencies would
    // make temperature and humidity move together, collapsing the square to a
    // diagonal and leaving most of the authored rectangles unreachable. 1/2500
    // puts a temperature zone at roughly 40 chunks across on Medium.
    "biome_classification": {
      "temperature": {
        "octaves": 3,
        "frequency": 0.0004,
        "lacunarity": 2.0,
        "persistence": 0.5
      },
      "humidity": {
        "octaves": 3,
        "frequency": 0.0007,
        "lacunarity": 2.0,
        "persistence": 0.5
      },
      // Half-width in columns of the jitter applied to the climate sample
      // position, which is what makes a biome seam wander instead of running
      // dead straight down the world. Not a per-column blend: one biome per
      // column is the output, so there is nothing to interpolate.
      "blend_columns": 24,
      // Shortest run of one biome that survives. Shorter runs are absorbed into
      // their left-hand neighbour, which is what stops a boundary from
      // scattering single-column islands of the wrong biome.
      "min_run_columns": 16,
      // Interleaved band at each boundary, as a half-width in columns
      // (VOID-060). Without this a biome changes completely between one column
      // and the next -- and because the seam runs the full height of the world,
      // that reads as a straight vertical cut through the terrain rather than
      // as a border between two places.
      //
      // Every boundary draws its own width from this range. A single width
      // would trade one uniform artefact for another: every border in the world
      // would be the same border. The low end is deliberately small so some
      // boundaries stay nearly hard, which is itself part of the variety.
      //
      // A band is clamped to half the run on either side of it, so two nearby
      // boundaries can never overlap; max_columns is therefore an upper bound on
      // intent, not a promise about any one border.
      //
      // Blending happens per *tile*, not per column: every column still belongs
      // to exactly one biome, so min_run_columns above is untouched and the two
      // features do not fight. See BiomeMap.BiomeAt.
      "transition": {
        "min_columns": 4,
        "max_columns": 40
      },
      // MVP's three surface biomes. Frostreach takes the cold third at any
      // humidity; the warm two-thirds split on humidity into forest and meadow.
      "rules": [
        { "biome": "void:frostreach", "temperature": [0.00, 0.30], "humidity": [0.00, 1.00] },
        { "biome": "void:forest",     "temperature": [0.30, 1.00], "humidity": [0.55, 1.00] },
        { "biome": "void:meadow",     "temperature": [0.30, 1.00], "humidity": [0.00, 0.55] }
      ]
    },
    // Phase 2 step 5 terrain materialisation (VOID-056). The only knob the
    // step needs that is not already in a biome palette: how many rows of
    // subsurface_block sit under the surface block. Biomes may override it --
    // Frostreach does -- and this is what the rest take.
    //
    // Changing it regenerates the near-surface of every existing seed with no
    // code change, which is the point of it living here.
    "terrain": {
      "default_subsurface_depth": 4
    },
    "size_preset": "medium",
    "size_presets": [
      { "id": "small", "width_tiles": 4200, "height_tiles": 1200 },
      { "id": "medium", "width_tiles": 6400, "height_tiles": 1800 },
      { "id": "large", "width_tiles": 8400, "height_tiles": 2400 }
    ]
  }
]
